# 复制本文件为同目录下的 .env，然后填入真实 key。
# .env 已经在仓库根目录的 .gitignore 里（第 108 行），不会被提交进 git。
#
# 用法（PowerShell）：
#   Copy-Item .env.example .env
#   notepad .env

# ============ 选一个 provider：deepseek | minimax | openai ============
LLM_PROVIDER=deepseek

# ============ DeepSeek（原生端点，最便宜，首选）============
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ============ MiniMax（OpenAI 兼容协议，走 ChatOpenAI）============
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.cn/v1
MINIMAX_MODEL=MiniMax-M3

# ============ OpenAI 兼容（填任何兼容 OpenAI 协议的网关）============
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
